{
  "name": "@workflow-worlds/business-state-infra",
  "version": "0.1.0",
  "description": "AWS CDK infrastructure for @workflow-worlds/business-state (DynamoDB table, Lambda, REST API Gateway + API keys)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "bootstrap": "cdk bootstrap",
    "deploy": "cdk deploy --outputs-file cdk-outputs.json",
    "destroy": "cdk destroy",
    "print-info": "node dist/scripts/print-info.js"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "aws-cdk": "^2.170.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
